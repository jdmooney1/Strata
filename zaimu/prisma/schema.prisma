// Zaimu — Cross-Border Asset Ownership Operating System
// Database Schema v1.0

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ORGANISATION & AUTH
// ─────────────────────────────────────────────

model Organisation {
  id          String   @id @default(cuid())
  name        String
  nameJa      String?  @map("name_ja")
  type        OrgType  @default(CORPORATE)
  country     String   @default("JP")
  timezone    String   @default("Asia/Tokyo")
  currency    String   @default("JPY")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  assets      Asset[]
  portfolios  Portfolio[]
  documents   Document[]
  tasks       Task[]
  reports     Report[]
  memories    InstitutionalMemory[]
  fxRates     FxRate[]

  @@map("organisations")
}

enum OrgType {
  CORPORATE
  FAMILY_OFFICE
  FUND
  REIT
  ASSET_MANAGER
}

model User {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  email          String    @unique
  name           String
  nameJa         String?   @map("name_ja")
  role           UserRole  @default(ANALYST)
  language       String    @default("ja")
  avatarUrl      String?   @map("avatar_url")
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  org            Organisation         @relation(fields: [orgId], references: [id])
  createdTasks   Task[]               @relation("TaskCreator")
  assignedTasks  Task[]               @relation("TaskAssignee")
  memories       InstitutionalMemory[]
  reportApprovals ReportApproval[]
  auditLogs      AuditLog[]
  ownedWorkflowSteps WorkflowStep[]     @relation("WorkflowStepOwner")
  approvalDecisions  ApprovalDecision[]

  @@map("users")
}

enum UserRole {
  ADMIN
  PORTFOLIO_MANAGER
  ANALYST
  BOARD_MEMBER
  EXTERNAL_ADVISER
  READ_ONLY
}

// ─────────────────────────────────────────────
// PORTFOLIO & ASSET
// ─────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  nameJa      String?  @map("name_ja")
  description String?
  targetAum   Decimal? @map("target_aum") @db.Decimal(18, 2)
  currency    String   @default("USD")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org         Organisation @relation(fields: [orgId], references: [id])
  assets      Asset[]

  @@map("portfolios")
}

model Asset {
  id                String         @id @default(cuid())
  orgId             String         @map("org_id")
  portfolioId       String?        @map("portfolio_id")
  name              String
  nameJa            String?        @map("name_ja")
  assetType         AssetType
  status            AssetStatus    @default(ACTIVE)
  country           String
  city              String
  address           String?
  totalArea         Decimal?       @map("total_area") @db.Decimal(12, 2)
  areaUnit          String?        @map("area_unit") @default("sqm")
  acquisitionDate   DateTime?      @map("acquisition_date")
  acquisitionCost   Decimal?       @map("acquisition_cost") @db.Decimal(18, 2)
  acquisitionFx     Decimal?       @map("acquisition_fx") @db.Decimal(12, 6)
  currency          String         @default("USD")
  currentValuation  Decimal?       @map("current_valuation") @db.Decimal(18, 2)
  lastValuationDate DateTime?      @map("last_valuation_date")
  occupancyRate     Decimal?       @map("occupancy_rate") @db.Decimal(5, 2)
  operationalScore  Int?           @map("operational_score")
  reportingScore    Int?           @map("reporting_score")
  covenantStatus    CovenantStatus @default(COMPLIANT) @map("covenant_status")
  refinancingDate   DateTime?      @map("refinancing_date")
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  org               Organisation       @relation(fields: [orgId], references: [id])
  portfolio         Portfolio?         @relation(fields: [portfolioId], references: [id])
  ownershipEntities OwnershipEntity[]
  loans             Loan[]
  leases            Lease[]
  capexItems        CapexItem[]
  valuations        Valuation[]
  documents         Document[]
  tasks             Task[]
  alerts            Alert[]
  pmReports         PmReport[]
  memories          InstitutionalMemory[]
  reportAssets      ReportAsset[]
  cashFlows         CashFlow[]
  extractedFacts    ExtractedFact[]
  riskEvents        RiskEvent[]
  healthScore       AssetHealthScore?
  workflows         Workflow[]

  @@map("assets")
}

enum AssetType {
  OFFICE
  RESIDENTIAL
  RETAIL
  LOGISTICS
  HOTEL
  MIXED_USE
  INDUSTRIAL
  INFRASTRUCTURE
  LAND
  OTHER
}

enum AssetStatus {
  ACTIVE
  UNDER_DD
  UNDER_CONSTRUCTION
  REFINANCING
  DISPOSAL
  DISPOSED
}

enum CovenantStatus {
  COMPLIANT
  WATCH
  BREACH
  WAIVED
  UNKNOWN
}

// ─────────────────────────────────────────────
// OWNERSHIP STRUCTURE
// ─────────────────────────────────────────────

model OwnershipEntity {
  id             String    @id @default(cuid())
  assetId        String    @map("asset_id")
  entityName     String    @map("entity_name")
  entityNameJa   String?   @map("entity_name_ja")
  entityType     String
  jurisdiction   String
  ownershipPct   Decimal   @map("ownership_pct") @db.Decimal(5, 2)
  parentEntity   String?   @map("parent_entity")
  taxId          String?   @map("tax_id")
  incorporatedAt DateTime? @map("incorporated_at")
  notes          String?

  asset          Asset     @relation(fields: [assetId], references: [id])

  @@map("ownership_entities")
}

// ─────────────────────────────────────────────
// DEBT STACK
// ─────────────────────────────────────────────

model Loan {
  id              String       @id @default(cuid())
  assetId         String       @map("asset_id")
  lenderName      String       @map("lender_name")
  loanType        LoanType     @map("loan_type")
  currency        String       @default("USD")
  originalBalance Decimal      @map("original_balance") @db.Decimal(18, 2)
  currentBalance  Decimal      @map("current_balance") @db.Decimal(18, 2)
  interestRate    Decimal      @map("interest_rate") @db.Decimal(6, 4)
  rateType        RateType     @map("rate_type")
  margin          Decimal?     @db.Decimal(6, 4)
  benchmark       String?
  originationDate DateTime     @map("origination_date")
  maturityDate    DateTime     @map("maturity_date")
  ltv             Decimal?     @db.Decimal(5, 2)
  dscr            Decimal?     @db.Decimal(6, 4)
  status          LoanStatus   @default(CURRENT)
  covenants       LoanCovenant[]
  amortisations   AmortisationSchedule[]

  asset           Asset        @relation(fields: [assetId], references: [id])

  @@map("loans")
}

enum LoanType {
  SENIOR
  MEZZANINE
  PREFERRED_EQUITY
  BRIDGE
  CONSTRUCTION
  TERM
  REVOLVING
}

enum RateType {
  FIXED
  FLOATING
  HYBRID
}

enum LoanStatus {
  CURRENT
  WATCH
  DEFAULT
  REFINANCING
  REPAID
}

model LoanCovenant {
  id           String         @id @default(cuid())
  loanId       String         @map("loan_id")
  covenantType String         @map("covenant_type")
  description  String
  threshold    String
  currentValue String?        @map("current_value")
  status       CovenantStatus @default(UNKNOWN)
  testFreq     String         @map("test_freq")
  nextTestDate DateTime?      @map("next_test_date")
  notes        String?

  loan         Loan           @relation(fields: [loanId], references: [id])

  @@map("loan_covenants")
}

model AmortisationSchedule {
  id        String    @id @default(cuid())
  loanId    String    @map("loan_id")
  dueDate   DateTime  @map("due_date")
  principal Decimal   @db.Decimal(18, 2)
  interest  Decimal   @db.Decimal(18, 2)
  balance   Decimal   @db.Decimal(18, 2)
  paid      Boolean   @default(false)
  paidAt    DateTime? @map("paid_at")

  loan      Loan      @relation(fields: [loanId], references: [id])

  @@map("amortisation_schedules")
}

// ─────────────────────────────────────────────
// LEASES
// ─────────────────────────────────────────────

model Lease {
  id              String      @id @default(cuid())
  assetId         String      @map("asset_id")
  tenantName      String      @map("tenant_name")
  tenantNameJa    String?     @map("tenant_name_ja")
  floor           String?
  suite           String?
  area            Decimal?    @db.Decimal(10, 2)
  areaUnit        String?     @map("area_unit") @default("sqm")
  currency        String      @default("USD")
  baseRent        Decimal     @map("base_rent") @db.Decimal(18, 2)
  rentFrequency   String      @map("rent_frequency") @default("MONTHLY")
  leaseStart      DateTime    @map("lease_start")
  leaseEnd        DateTime    @map("lease_end")
  breakDate       DateTime?   @map("break_date")
  renewalWindow   DateTime?   @map("renewal_window")
  renewalOptions  String?     @map("renewal_options")
  status          LeaseStatus @default(ACTIVE)
  securityDeposit Decimal?    @map("security_deposit") @db.Decimal(18, 2)
  notes           String?
  documentId      String?     @map("document_id")

  asset           Asset       @relation(fields: [assetId], references: [id])

  @@map("leases")
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  PENDING
  NOTICE_GIVEN
  RENEWED
  SURRENDERED
}

// ─────────────────────────────────────────────
// CAPEX
// ─────────────────────────────────────────────

model CapexItem {
  id            String      @id @default(cuid())
  assetId       String      @map("asset_id")
  category      String
  description   String
  descriptionJa String?     @map("description_ja")
  budget        Decimal     @db.Decimal(18, 2)
  spent         Decimal     @default(0) @db.Decimal(18, 2)
  currency      String      @default("USD")
  status        CapexStatus @default(PLANNED)
  contractor    String?
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  notes         String?

  asset         Asset       @relation(fields: [assetId], references: [id])

  @@map("capex_items")
}

enum CapexStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETE
  CANCELLED
  ON_HOLD
}

// ─────────────────────────────────────────────
// VALUATIONS
// ─────────────────────────────────────────────

model Valuation {
  id            String    @id @default(cuid())
  assetId       String    @map("asset_id")
  valuationDate DateTime  @map("valuation_date")
  value         Decimal   @db.Decimal(18, 2)
  currency      String    @default("USD")
  method        String
  valuer        String
  capRate       Decimal?  @map("cap_rate") @db.Decimal(6, 4)
  noi           Decimal?  @db.Decimal(18, 2)
  documentId    String?   @map("document_id")
  notes         String?

  asset         Asset     @relation(fields: [assetId], references: [id])

  @@map("valuations")
}

// ─────────────────────────────────────────────
// PM REPORTS
// ─────────────────────────────────────────────

model PmReport {
  id           String         @id @default(cuid())
  assetId      String         @map("asset_id")
  reportPeriod DateTime       @map("report_period")
  submittedAt  DateTime?      @map("submitted_at")
  goi          Decimal?       @db.Decimal(18, 2)
  noi          Decimal?       @db.Decimal(18, 2)
  opex         Decimal?       @db.Decimal(18, 2)
  occupancy    Decimal?       @db.Decimal(5, 2)
  currency     String         @default("USD")
  pmCommentary String?        @map("pm_commentary")
  aiSummary    String?        @map("ai_summary")
  aiRiskFlags  Json?          @map("ai_risk_flags")
  documentId   String?        @map("document_id")
  status       PmReportStatus @default(PENDING)

  asset        Asset          @relation(fields: [assetId], references: [id])

  @@map("pm_reports")
}

enum PmReportStatus {
  PENDING
  RECEIVED
  REVIEWED
  FLAGGED
}

// ─────────────────────────────────────────────
// CASH FLOWS
// ─────────────────────────────────────────────

model CashFlow {
  id          String        @id @default(cuid())
  assetId     String        @map("asset_id")
  date        DateTime
  category    String
  description String
  amount      Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD")
  flowType    CashFlowType  @map("flow_type")
  actual      Boolean       @default(false)
  notes       String?

  asset       Asset         @relation(fields: [assetId], references: [id])

  @@map("cash_flows")
}

enum CashFlowType {
  INFLOW
  OUTFLOW
}

// ─────────────────────────────────────────────
// TREASURY & FX
// ─────────────────────────────────────────────

model FxRate {
  id            String       @id @default(cuid())
  orgId         String       @map("org_id")
  baseCurrency  String       @map("base_currency")
  quoteCurrency String       @map("quote_currency")
  rate          Decimal      @db.Decimal(16, 8)
  source        String       @default("MANUAL")
  rateDate      DateTime     @map("rate_date")
  createdAt     DateTime     @default(now()) @map("created_at")

  org           Organisation @relation(fields: [orgId], references: [id])

  @@unique([orgId, baseCurrency, quoteCurrency, rateDate])
  @@map("fx_rates")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id            String         @id @default(cuid())
  orgId         String         @map("org_id")
  assetId       String?        @map("asset_id")
  name          String
  nameJa        String?        @map("name_ja")
  docType       DocumentType   @map("doc_type")
  status        DocStatus      @default(PENDING)
  fileUrl       String?        @map("file_url")
  fileSize      Int?           @map("file_size")
  mimeType      String?        @map("mime_type")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  processedAt   DateTime?      @map("processed_at")
  extractedData Json?          @map("extracted_data")
  aiSummary     String?        @map("ai_summary")
  aiSummaryJa   String?        @map("ai_summary_ja")
  aiFlags       Json?          @map("ai_flags")
  tags          String[]
  expiresAt     DateTime?      @map("expires_at")
  effectiveDate DateTime?      @map("effective_date")
  parties       String[]
  notes         String?

  org           Organisation   @relation(fields: [orgId], references: [id])
  asset         Asset?         @relation(fields: [assetId], references: [id])
  obligations   DocumentObligation[]
  extractedFacts ExtractedFact[]

  @@map("documents")
}

enum DocumentType {
  LOAN_AGREEMENT
  LEASE_AGREEMENT
  VALUATION_REPORT
  PM_REPORT
  INSURANCE_POLICY
  TAX_DOCUMENT
  CORPORATE_DOCUMENT
  BOARD_RESOLUTION
  CAPEX_QUOTE
  INVOICE
  FINANCIAL_STATEMENT
  LENDER_STATEMENT
  RENT_ROLL
  LEGAL_OPINION
  ENVIRONMENTAL_REPORT
  OTHER
}

enum DocStatus {
  PENDING
  PROCESSING
  EXTRACTED
  REVIEWED
  ARCHIVED
  ERROR
}

model DocumentObligation {
  id            String           @id @default(cuid())
  documentId    String           @map("document_id")
  description   String
  descriptionJa String?          @map("description_ja")
  dueDate       DateTime?        @map("due_date")
  category      String
  priority      Priority         @default(MEDIUM)
  status        ObligationStatus @default(OPEN)
  notes         String?

  document      Document         @relation(fields: [documentId], references: [id])

  @@map("document_obligations")
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ObligationStatus {
  OPEN
  IN_PROGRESS
  COMPLETE
  OVERDUE
  WAIVED
}

// ─────────────────────────────────────────────
// EXTRACTED FACTS (AI document analysis)
// ─────────────────────────────────────────────

model ExtractedFact {
  id           String       @id @default(cuid())
  documentId   String       @map("document_id")
  assetId      String?      @map("asset_id")
  category     FactCategory
  label        String
  value        String
  valueJa      String?      @map("value_ja")
  confidence   Float?       @db.DoublePrecision
  sourceText   String?      @map("source_text")
  pageRef      String?      @map("page_ref")
  flagged      Boolean      @default(false)
  flagReason   String?      @map("flag_reason")
  createdAt    DateTime     @default(now()) @map("created_at")

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id])

  @@map("extracted_facts")
}

enum FactCategory {
  DATE
  PARTY
  AMOUNT
  LEASE_TERM
  LOAN_TERM
  COVENANT
  OBLIGATION
  EXPIRY
  MISSING_INFO
  OTHER
}

// ─────────────────────────────────────────────
// BOARD REPORTING
// ─────────────────────────────────────────────

model Report {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  title       String
  titleJa     String?      @map("title_ja")
  reportType  ReportType   @map("report_type")
  period      DateTime
  status      ReportStatus @default(DRAFT)
  language    String       @default("ja")
  content     Json?
  generatedAt DateTime?    @map("generated_at")
  finalizedAt DateTime?    @map("finalized_at")
  pdfUrl      String?      @map("pdf_url")
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  org         Organisation   @relation(fields: [orgId], references: [id])
  assets      ReportAsset[]
  approvals   ReportApproval[]

  @@map("reports")
}

enum ReportType {
  MONTHLY_BOARD
  QUARTERLY_REVIEW
  ANNUAL_SUMMARY
  REFINANCING_MEMO
  RISK_SUMMARY
  INVESTMENT_UPDATE
  CASH_FLOW_FORECAST
  COVENANT_REPORT
  FX_EXPOSURE
  CUSTOM
}

enum ReportStatus {
  DRAFT
  GENERATING
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model ReportAsset {
  id           String  @id @default(cuid())
  reportId     String  @map("report_id")
  assetId      String  @map("asset_id")
  commentary   String?
  commentaryJa String? @map("commentary_ja")

  report       Report  @relation(fields: [reportId], references: [id])
  asset        Asset   @relation(fields: [assetId], references: [id])

  @@map("report_assets")
}

model ReportApproval {
  id         String    @id @default(cuid())
  reportId   String    @map("report_id")
  userId     String    @map("user_id")
  status     String
  approvedAt DateTime? @map("approved_at")
  comments   String?

  report     Report    @relation(fields: [reportId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@map("report_approvals")
}

// ─────────────────────────────────────────────
// TASKS & ALERTS
// ─────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  assetId     String?      @map("asset_id")
  title       String
  titleJa     String?      @map("title_ja")
  description String?
  category    TaskCategory
  priority    Priority     @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  creatorId   String       @map("creator_id")
  assigneeId  String?      @map("assignee_id")
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  tags        String[]
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  org         Organisation @relation(fields: [orgId], references: [id])
  asset       Asset?       @relation(fields: [assetId], references: [id])
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@map("tasks")
}

enum TaskCategory {
  REPORTING
  COMPLIANCE
  COVENANT
  REFINANCING
  LEASE_MANAGEMENT
  CAPEX
  LEGAL
  LENDER_COMMUNICATION
  PM_REVIEW
  FX_MANAGEMENT
  BOARD_PREPARATION
  DOCUMENT_COLLECTION
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETE
  CANCELLED
}

model Alert {
  id          String        @id @default(cuid())
  assetId     String?       @map("asset_id")
  alertType   AlertType     @map("alert_type")
  severity    AlertSeverity
  title       String
  titleJa     String?       @map("title_ja")
  message     String
  messageJa   String?       @map("message_ja")
  triggeredAt DateTime      @default(now()) @map("triggered_at")
  resolvedAt  DateTime?     @map("resolved_at")
  resolved    Boolean       @default(false)
  metadata    Json?

  asset       Asset?        @relation(fields: [assetId], references: [id])

  @@map("alerts")
}

enum AlertType {
  COVENANT_BREACH
  COVENANT_WATCH
  LOAN_MATURITY
  LEASE_EXPIRY
  LEASE_BREAK
  RENEWAL_WINDOW
  REPORT_OVERDUE
  CAPEX_OVERRUN
  FX_THRESHOLD
  OCCUPANCY_DROP
  DOCUMENT_EXPIRY
  OBLIGATION_DUE
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

// ─────────────────────────────────────────────
// INSTITUTIONAL MEMORY
// ─────────────────────────────────────────────

model InstitutionalMemory {
  id         String     @id @default(cuid())
  orgId      String     @map("org_id")
  assetId    String?    @map("asset_id")
  userId     String     @map("user_id")
  memoryType MemoryType @map("memory_type")
  title      String
  titleJa    String?    @map("title_ja")
  content    String
  contentJa  String?    @map("content_ja")
  tags       String[]
  importance Priority   @default(MEDIUM)
  period     DateTime?
  embedding  Json?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  org        Organisation @relation(fields: [orgId], references: [id])
  asset      Asset?       @relation(fields: [assetId], references: [id])
  user       User         @relation(fields: [userId], references: [id])

  @@map("institutional_memories")
}

enum MemoryType {
  BOARD_DECISION
  INVESTMENT_RATIONALE
  COVENANT_DISCUSSION
  REFINANCING_DECISION
  OPERATIONAL_INCIDENT
  LENDER_DISCUSSION
  ASSUMPTION_CHANGE
  RISK_ASSESSMENT
  TENANT_DISCUSSION
  LEGAL_ADVICE
  TAX_POSITION
  OTHER
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// OPERATIONAL RISK ENGINE
// ─────────────────────────────────────────────

enum RiskCategory {
  LEASE
  DEBT
  REPORTING
  COMPLIANCE
  TREASURY

  @@map("RiskCategory")
}

enum RiskSeverity {
  INFORMATIONAL
  WARNING
  CRITICAL
  ESCALATED

  @@map("RiskSeverity")
}

enum RiskStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
  ESCALATED

  @@map("RiskStatus")
}

enum EscalationLevel {
  NONE
  ANALYST
  SENIOR_ANALYST
  FUND_MANAGER
  BOARD

  @@map("EscalationLevel")
}

/// Definition of a monitoring rule — evaluated on every risk engine run.
model RiskRule {
  id              String       @id @default(cuid())
  code            String       @unique            // e.g. "LEASE_EXPIRY_30D"
  name            String
  nameJa          String?      @map("name_ja")
  description     String
  category        RiskCategory
  defaultSeverity RiskSeverity @map("default_severity")
  enabled         Boolean      @default(true)
  parameters      Json?        // { thresholdDays: 30 } etc.
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt        @map("updated_at")

  events          RiskEvent[]

  @@map("risk_rules")
}

/// A triggered instance of a risk rule against a specific asset.
model RiskEvent {
  id              String          @id @default(cuid())
  orgId           String          @map("org_id")
  assetId         String?         @map("asset_id")
  ruleId          String?         @map("rule_id")
  ruleCode        String          @map("rule_code")   // denormalised for fast queries
  category        RiskCategory
  severity        RiskSeverity
  status          RiskStatus      @default(OPEN)
  escalationLevel EscalationLevel @default(NONE)      @map("escalation_level")

  title           String
  titleJa         String?         @map("title_ja")
  description     String
  descriptionJa   String?         @map("description_ja")

  // Explainability
  triggerData           Json?     @map("trigger_data")       // snapshot of the data that fired the rule
  sourceDocumentIds     String[]  @map("source_document_ids")
  recommendedAction     String?   @map("recommended_action")
  recommendedActionJa   String?   @map("recommended_action_ja")
  confidence            Float?                               // 0.0–1.0

  // AI-generated context (populated lazily)
  aiAnalysis      String?  @map("ai_analysis")
  aiAnalysisJa    String?  @map("ai_analysis_ja")
  aiAnalyzedAt    DateTime? @map("ai_analyzed_at")

  // Temporal
  firstDetectedAt DateTime  @default(now()) @map("first_detected_at")
  lastEvaluatedAt DateTime  @default(now()) @map("last_evaluated_at")
  dueDate         DateTime?                 @map("due_date")
  acknowledgedAt  DateTime?                 @map("acknowledged_at")
  acknowledgedBy  String?                   @map("acknowledged_by")
  resolvedAt      DateTime?                 @map("resolved_at")
  resolvedBy      String?                   @map("resolved_by")
  suppressedUntil DateTime?                 @map("suppressed_until")

  // Recurrence
  occurrenceCount Int @default(1) @map("occurrence_count")
  recurrenceCount Int @default(0) @map("recurrence_count")
  lastResolvedAt  DateTime?      @map("last_resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  asset       Asset?          @relation(fields: [assetId], references: [id])
  rule        RiskRule?       @relation(fields: [ruleId], references: [id])
  escalations RiskEscalation[]

  @@unique([assetId, ruleCode])   // one open event per rule per asset
  @@index([orgId, status])
  @@index([assetId, status])
  @@index([severity, status])
  @@map("risk_events")
}

/// History of escalation actions on a RiskEvent.
model RiskEscalation {
  id          String          @id @default(cuid())
  eventId     String          @map("event_id")
  level       EscalationLevel
  escalatedBy String?         @map("escalated_by")
  escalatedAt DateTime        @default(now()) @map("escalated_at")
  note        String?

  event RiskEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("risk_escalations")
}

/// Computed health score for an asset — refreshed on every risk engine run.
model AssetHealthScore {
  id                String  @id @default(cuid())
  assetId           String  @unique @map("asset_id")
  orgId             String  @map("org_id")

  overallScore      Float   @map("overall_score")       // 0–100
  leaseScore        Float   @map("lease_score")
  debtScore         Float   @map("debt_score")
  reportingScore    Float   @map("reporting_score")
  complianceScore   Float   @map("compliance_score")
  treasuryScore     Float   @map("treasury_score")
  completenessScore Float   @map("completeness_score")  // data completeness
  confidenceScore   Float   @map("confidence_score")    // how reliable the scores are

  openCritical      Int @default(0) @map("open_critical")
  openWarnings      Int @default(0) @map("open_warnings")
  openInfo          Int @default(0) @map("open_info")
  openEscalated     Int @default(0) @map("open_escalated")

  scoredAt  DateTime @default(now()) @map("scored_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@map("asset_health_scores")
}

// ─────────────────────────────────────────────
// INSTITUTIONAL WORKFLOW LAYER
// ─────────────────────────────────────────────

enum WorkflowType {
  REFINANCING
  LEASE_RENEWAL
  VALUATION_UPDATE
  MONTHLY_REPORTING
  INSURANCE_RENEWAL
  COVENANT_REPORTING
  CAPEX_APPROVAL
  ACQUISITION_ONBOARDING
  CUSTOM

  @@map("WorkflowType")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  BLOCKED
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("WorkflowStatus")
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETE
  BLOCKED
  SKIPPED
  OVERDUE

  @@map("StepStatus")
}

enum StepType {
  ACTION
  APPROVAL
  DOCUMENT_UPLOAD
  MILESTONE
  EXTERNAL

  @@map("StepType")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ABSTAINED

  @@map("ApprovalStatus")
}

enum EscalationPath {
  STANDARD
  EXPEDITED
  BOARD
  EXTERNAL

  @@map("EscalationPath")
}

/// Reusable workflow template — defines the steps for a business process.
model WorkflowTemplate {
  id           String       @id @default(cuid())
  orgId        String?      @map("org_id")    // null = system-level template
  code         String       @unique
  name         String
  nameJa       String?      @map("name_ja")
  description  String?
  workflowType WorkflowType @map("workflow_type")
  assetTypes   String[]     @map("asset_types")    // AssetType codes this applies to
  jurisdictions String[]                            // ISO country codes
  isSystem     Boolean      @default(false)         @map("is_system")
  isActive     Boolean      @default(true)          @map("is_active")
  estimatedDays Int?        @map("estimated_days")

  steps     WorkflowTemplateStep[]
  workflows Workflow[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@map("workflow_templates")
}

/// An ordered step within a workflow template.
model WorkflowTemplateStep {
  id               String   @id @default(cuid())
  templateId       String   @map("template_id")
  stepOrder        Int      @map("step_order")
  name             String
  nameJa           String?  @map("name_ja")
  description      String?
  stepType         StepType @map("step_type")
  dueDaysFromStart Int?     @map("due_days_from_start")   // offset from workflow.startedAt
  defaultOwnerRole String?  @map("default_owner_role")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  approverRoles    String[] @map("approver_roles")
  dependsOnOrders  Int[]    @map("depends_on_orders")   // stepOrder values this depends on
  isRequired       Boolean  @default(true) @map("is_required")
  guidanceNote     String?  @map("guidance_note")

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepOrder])
  @@map("workflow_template_steps")
}

/// A running workflow instance for a specific asset.
model Workflow {
  id           String         @id @default(cuid())
  orgId        String         @map("org_id")
  assetId      String         @map("asset_id")
  templateId   String?        @map("template_id")
  workflowType WorkflowType   @map("workflow_type")
  status       WorkflowStatus @default(DRAFT)
  title        String
  titleJa      String?        @map("title_ja")
  description  String?

  linkedRiskEventIds String[] @map("linked_risk_event_ids")

  startedAt   DateTime? @map("started_at")
  targetDate  DateTime? @map("target_date")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  cancelReason String?  @map("cancel_reason")

  createdById String   @map("created_by_id")
  notes       String?

  // AI assistance
  aiSuggestions   String?   @map("ai_suggestions")
  aiAnalyzedAt    DateTime? @map("ai_analyzed_at")

  asset    Asset             @relation(fields: [assetId], references: [id])
  template WorkflowTemplate? @relation(fields: [templateId], references: [id])
  steps    WorkflowStep[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@index([orgId, status])
  @@index([assetId, status])
  @@map("workflows")
}

/// A single step (action item) within a running workflow.
model WorkflowStep {
  id          String     @id @default(cuid())
  workflowId  String     @map("workflow_id")
  stepOrder   Int        @map("step_order")
  name        String
  nameJa      String?    @map("name_ja")
  description String?
  stepType    StepType   @map("step_type")
  status      StepStatus @default(NOT_STARTED)

  // Ownership & assignment
  ownerId    String?  @map("owner_id")
  assigneeIds String[] @map("assignee_ids")

  // Scheduling
  dueDate     DateTime? @map("due_date")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")
  completionNote String? @map("completion_note")

  // Escalation
  escalationPath EscalationPath @default(STANDARD) @map("escalation_path")
  escalatedAt    DateTime?      @map("escalated_at")
  escalatedTo    String?        @map("escalated_to")
  escalationNote String?        @map("escalation_note")

  // Dependencies & blocks
  dependsOnStepIds String[] @map("depends_on_step_ids")
  blockedReason    String?  @map("blocked_reason")

  // Linked data
  linkedRiskEventId String?  @map("linked_risk_event_id")
  documentIds       String[] @map("document_ids")
  guidanceNote      String?  @map("guidance_note")
  notes             String?

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  owner     User?             @relation("WorkflowStepOwner", fields: [ownerId], references: [id])
  approvals WorkflowApproval[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@index([workflowId, status])
  @@map("workflow_steps")
}

/// An approval request tied to a workflow step, with a sequential reviewer chain.
model WorkflowApproval {
  id             String         @id @default(cuid())
  workflowStepId String         @map("workflow_step_id")
  workflowId     String         @map("workflow_id")
  title          String
  description    String?
  requestedById  String         @map("requested_by_id")
  requestedAt    DateTime       @default(now()) @map("requested_at")
  dueDate        DateTime?      @map("due_date")
  reviewerIds    String[]       @map("reviewer_ids")      // ordered reviewer chain
  currentIndex   Int            @default(0) @map("current_index")
  status         ApprovalStatus @default(PENDING)
  completedAt    DateTime?      @map("completed_at")
  rejectionNote  String?        @map("rejection_note")

  step      WorkflowStep       @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@map("workflow_approvals")
}

/// A single reviewer's decision within an approval chain.
model ApprovalDecision {
  id         String         @id @default(cuid())
  approvalId String         @map("approval_id")
  reviewerId String         @map("reviewer_id")
  decision   ApprovalStatus
  decidedAt  DateTime       @default(now()) @map("decided_at")
  note       String?

  approval WorkflowApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  reviewer User             @relation(fields: [reviewerId], references: [id])

  @@map("approval_decisions")
}
